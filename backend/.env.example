PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/college_management
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated exact browser origins. Blank defaults to local dev origins
# outside production and to no cross-origin browser origins in production.
CORS_ORIGINS=

# Login throttling defaults: 10 attempts per IP per 15 minutes.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Required only when running scripts/createInitialPrincipal.js
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
